# 복사해서 fastlane/.env 로 저장(이 파일은 git에 올리지 않는다)
ASC_KEY_ID=ABCDE12345
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_FILEPATH=fastlane/keys/AuthKey_ABCDE12345.p8
BUNDLE_ID=com.example.app
SCHEME=MyApp
PROJECT=MyApp.xcodeproj
LOCALE=ko
# 선택
INFO_PLIST=MyApp/Info.plist
TEAM_ID=ABCDE12345
APP_NAME=My App
APP_SKU=myapp
# 암호화: Info.plist의 ITSAppUsesNonExemptEncryption과 같은 값으로(기본 false).
# doctor가 소스를 훑어 데이터 암호화 API(AES.GCM 등)가 보이는데 NO면 ⚠️로 알려 준다.
USES_ENCRYPTION=false
# SRC_DIR=MyApp    # 훑을 소스 폴더. 생략하면 프로젝트 루트 전체(Pods·DerivedData 등은 제외)
